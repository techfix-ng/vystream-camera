#include "resource.h"
IDI_APP ICON "vystream.ico"
1 VERSIONINFO
 FILEVERSION 1,3,5,0
 PRODUCTVERSION 1,3,5,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "TechFixNG"
      VALUE "FileDescription", "VyStream Bridge for vMix"
      VALUE "FileVersion", "1.3.5"
      VALUE "InternalName", "VyStream-vMix-Bridge"
      VALUE "OriginalFilename", "VyStream-vMix-Bridge.exe"
      VALUE "ProductName", "VyStream Bridge for vMix"
      VALUE "ProductVersion", "1.3.5"
    END
  END
  BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END
END
