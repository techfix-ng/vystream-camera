bool tcpRequest(const std::string&host,int port,const std::string&request,std::string&response,int timeoutMs=1500){addrinfo h{},*a=nullptr;h.ai_family=AF_INET;h.ai_socktype=SOCK_STREAM;if(getaddrinfo(host.c_str(),std::to_string(port).c_str(),&h,&a))return false;SOCKET s=socket(a->ai_family,a->ai_socktype,a->ai_protocol);if(s==INVALID_SOCKET){freeaddrinfo(a);return false;}DWORD tv=timeoutMs;setsockopt(s,SOL_SOCKET,SO_RCVTIMEO,(char*)&tv,sizeof(tv));setsockopt(s,SOL_SOCKET,SO_SNDTIMEO,(char*)&tv,sizeof(tv));bool ok=connect(s,a->ai_addr,(int)a->ai_addrlen)!=SOCKET_ERROR;freeaddrinfo(a);if(!ok){closesocket(s);return false;}send(s,request.data(),(int)request.size(),0);char b[8192];int n;while((n=recv(s,b,sizeof(b),0))>0)response.append(b,n);closesocket(s);return true;}
bool vmixHttp(const std::string&query,std::string*body=nullptr){std::string path="/api"+(query.empty()?"":"/?"+query);std::string req="GET "+path+" HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n",res;if(!tcpRequest("127.0.0.1",8088,req,res))return false;auto p=res.find("\r\n\r\n");if(body&&p!=std::string::npos)*body=res.substr(p+4);return res.find(" 200 ")!=std::string::npos;}
int maxInputNumber(const std::string&xml){int high=0;size_t p=0;while((p=xml.find("number=\"",p))!=std::string::npos){p+=8;high=std::max(high,atoi(xml.c_str()+p));}return high;}
bool inputKeyExists(const std::string&xml,const std::string&key,int*number=nullptr){
  if(key.empty())return false;
  std::string marker="key=\""+key+"\"";
  size_t pos=xml.find(marker);
  if(pos==std::string::npos)return false;

  size_t start=xml.rfind("<input ",pos);
  size_t end=xml.find('>',pos);
  if(start==std::string::npos||end==std::string::npos)return false;

  std::string node=xml.substr(start,end-start+1);
  size_t n=node.find("number=\"");
  if(n==std::string::npos)return false;
  n+=8;
  size_t ne=node.find('"',n);
  if(ne==std::string::npos)return false;

  int current=atoi(node.substr(n,ne-n).c_str());
  if(current<=0)return false;
  if(number)*number=current;
  return true;
}
bool findVmixSrtInput(const std::string&xml,Camera&c){
  std::string marker="SRT "+std::to_string(c.srtPort);
  size_t pos=0;
  while((pos=xml.find("<input ",pos))!=std::string::npos){
    size_t end=xml.find("</input>",pos);
    if(end==std::string::npos)break;
    std::string node=xml.substr(pos,end-pos+8);
    if(node.find("type=\"SRT\"")!=std::string::npos &&
       node.find(marker)!=std::string::npos){
      auto attr=[&](const char*name)->std::string{
        std::string key=std::string(name)+"=\"";
        size_t a=node.find(key);
        if(a==std::string::npos)return{};
        a+=key.size();
        size_t b=node.find('"',a);
        return b==std::string::npos?std::string{}:node.substr(a,b-a);
      };
      std::string number=attr("number");
      std::string key=attr("key");
      if(number.empty()||key.empty())return false;
      c.inputNumber=atoi(number.c_str());
      c.inputKey=key;
      return c.inputNumber>0;
    }
    pos=end+8;
  }
  return false;
}

bool mapVmixInput(Camera&c){
  std::string xml;
  if(!vmixHttp("",&xml))return false;
  if(!findVmixSrtInput(xml,c))return false;

  vmixHttp("Function=SetInputName&Input="+urlEncode(c.inputKey)+
           "&Value="+urlEncode(c.name));

  writeIni(c.id,"input",std::to_string(c.inputNumber));
  writeIni(c.id,"input_key",c.inputKey);
  writeIni(c.id,"name",c.name);
  return true;
}
void ensureVmixInputs(){
  std::string xml;
  if(!vmixHttp("",&xml))return;

  std::vector<Camera> work;

  {
    std::lock_guard<std::mutex>lock(cameraMutex);

    for(auto&c:cameras){
      if(!c.autoAdd||GetTickCount()-c.lastSeen>6000||c.addPending)continue;

      int currentNumber=0;

      if(inputKeyExists(xml,c.inputKey,&currentNumber)){
        if(c.inputNumber!=currentNumber){
          c.inputNumber=currentNumber;
          writeIni(c.id,"input",std::to_string(currentNumber));
        }
        continue;
      }

      c.inputNumber=0;
      c.inputKey.clear();
      c.addPending=true;
      work.push_back(c);
    }
  }

  for(auto c:work){
    bool ok=mapVmixInput(c);

    {
      std::lock_guard<std::mutex>lock(cameraMutex);
      auto it=std::find_if(
        cameras.begin(),cameras.end(),
        [&](const Camera&x){return x.id==c.id;}
      );

      if(it!=cameras.end()){
        it->addPending=false;

        if(ok){
          it->inputNumber=c.inputNumber;
          it->inputKey=c.inputKey;
        }
      }
    }

    postStatus(
      ok
        ? L"VyStream camera mapped to its vMix SRT input."
        : L"Create the matching SRT Listener input in vMix, then VyStream will map it automatically."
    );
  }
}

