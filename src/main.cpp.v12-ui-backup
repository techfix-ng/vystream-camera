void sendTally(Camera&c,int state){std::string m="VYSTALLY1|"+c.token+"|"+std::to_string(state);sockaddr_in to{};to.sin_family=AF_INET;to.sin_port=htons((u_short)c.talkPort);if(InetPtonA(AF_INET,c.ip.c_str(),&to.sin_addr)==1)sendto(discoverySocket,m.data(),(int)m.size(),0,(sockaddr*)&to,sizeof(to));}
void tallyLoop(){
  while(running){
    SOCKET sock=socket(AF_INET,SOCK_STREAM,IPPROTO_TCP);

    if(sock==INVALID_SOCKET){
      Sleep(1000);
      continue;
    }

    DWORD timeout=2500;
    setsockopt(sock,SOL_SOCKET,SO_RCVTIMEO,(char*)&timeout,sizeof(timeout));
    setsockopt(sock,SOL_SOCKET,SO_SNDTIMEO,(char*)&timeout,sizeof(timeout));

    sockaddr_in addr{};
    addr.sin_family=AF_INET;
    addr.sin_port=htons(8099);
    InetPtonA(AF_INET,"127.0.0.1",&addr.sin_addr);

    if(connect(sock,(sockaddr*)&addr,sizeof(addr))==SOCKET_ERROR){
      closesocket(sock);
      Sleep(1000);
      continue;
    }

    const char* subscribe="SUBSCRIBE TALLY\r\n";
    if(send(sock,subscribe,(int)strlen(subscribe),0)==SOCKET_ERROR){
      closesocket(sock);
      Sleep(1000);
      continue;
    }

    char buffer[2048];
    std::string pending;

    while(running){
      int n=recv(sock,buffer,sizeof(buffer),0);

      if(n<=0)
        break;

      pending.append(buffer,n);

      size_t e;
      while((e=pending.find("\r\n"))!=std::string::npos){
        std::string line=pending.substr(0,e);
        pending.erase(0,e+2);

        const std::string prefix="TALLY OK ";
        if(line.rfind(prefix,0)!=0)
          continue;

        std::string states=line.substr(prefix.size());

        std::lock_guard<std::mutex>lock(cameraMutex);

        for(auto&c:cameras){
          if(c.inputNumber<=0 ||
             c.inputNumber>(int)states.size())
            continue;

          char raw=states[c.inputNumber-1];

          // vMix TALLY:
          // 0 = off/standby
          // 1 = programme/output
          // 2 = preview
          if(raw!='0' && raw!='1' && raw!='2')
            continue;

          int state=raw-'0';

          if(state!=c.tally){
            c.tally=state;
            sendTally(c,state);
            PostMessageW(mainWindow,WM_TALLY,0,0);
          }
        }
      }
    }

    closesocket(sock);

    if(running)
      Sleep(700);
  }
}
